{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: manage preferences, shortcuts, diagnostics.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:event:default",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:window:allow-close",
    "log:allow-log",
    "allow-get-settings",
    "allow-update-settings",
    "allow-reset-settings",
    "allow-get-recent-items",
    "allow-clear-search-history",
    "allow-get-index-status",
    "allow-rebuild-index",
    "allow-open-settings-window",
    "allow-get-shortcut-status",
    "allow-begin-shortcut-recording",
    "allow-end-shortcut-recording",
    "allow-set-shortcut",
    "allow-reset-shortcuts",
    "allow-validate-shortcut",
    "allow-get-capslock-support",
    "allow-preview-capslock-indicator",
    "allow-get-platform-info",
    "allow-get-system-appearance",
    "allow-get-browsers",
    "allow-get-diagnostics",
    "allow-read-log-tail",
    "allow-open-log-folder",
    "allow-clear-cache",
    "allow-open-repository",
    "allow-quit-app",
    "allow-get-update-status",
    "allow-check-for-updates",
    "allow-download-update",
    "allow-install-update",
    "allow-open-release-page"
  ]
}
