{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumio",
  "mainBinaryName": "lumio",
  "identifier": "com.lumio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: lumio-icon: http://lumio-icon.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Spotlight-style search and Caps Lock indicator",
    "longDescription": "Lumio is a keyboard-first productivity utility with a Spotlight-style launcher for applications, files and quick actions, plus a Caps Lock indicator that appears next to the mouse pointer.",
    "copyright": "Copyright © Lumio contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1MTg2NkUxNjJGQkVGODkKUldTSjcvdGk0V1lZdFI4MkxYeW1CVkgyNGZ1R0prZ3phbnNPWFFuNmpOeHpCMnpQYWhDeDlBRU8K",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
